{
  "name": "@pogly/spacetimedb-history",
  "version": "0.1.2",
  "description": "Audit log, per-person undo/redo and point-in-time reads for SpacetimeDB, as a submodule. A stopgap until native time travel. Same schema as history.rs / History.cs.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "prepack": "npm run build"
  },
  "keywords": [
    "spacetimedb",
    "submodule",
    "audit-log",
    "undo",
    "history",
    "time-travel"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Gazz-Stripbolt/spacetimedb-history.git",
    "directory": "typescript"
  },
  "homepage": "https://github.com/Gazz-Stripbolt/spacetimedb-history/tree/main/typescript#readme",
  "bugs": {
    "url": "https://github.com/Gazz-Stripbolt/spacetimedb-history/issues"
  },
  "submodule": {
    "category": "database"
  },
  "peerDependencies": {
    "spacetimedb": "2.13.* || 2.14.*"
  },
  "devDependencies": {
    "spacetimedb": "2.14.*",
    "typescript": "^5.9.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
